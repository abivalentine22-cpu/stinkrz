{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string"
    },
    "receiver_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "is_sticker": {
      "type": "boolean",
      "default": false
    },
    "sticker_id": {
      "type": "string"
    },
    "media_url": {
      "type": "string",
      "description": "URL to uploaded image or video"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "description": "Type of media if media_url is present"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "media_uri": {
      "type": "string",
      "description": "Private storage reference; only the server may assign it."
    }
  },
  "required": [
    "sender_email",
    "receiver_email",
    "content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
