{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string"
    },
    "receiver_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "is_sticker": {
      "type": "boolean",
      "default": false
    },
    "sticker_id": {
      "type": "string"
    },
    "media_url": {
      "type": "string",
      "description": "URL to uploaded image or video"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "description": "Type of media if media_url is present"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "sender_email",
    "receiver_email",
    "content"
  ]
}