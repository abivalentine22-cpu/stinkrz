{
  "name": "Favorite",
  "type": "object",
  "properties": {
    "from_email": {
      "type": "string",
      "description": "Who sent the tap/favorite"
    },
    "to_email": {
      "type": "string",
      "description": "Who received the tap/favorite"
    }
  },
  "required": [
    "from_email",
    "to_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
