{
  "name": "ProfileView",
  "type": "object",
  "properties": {
    "viewer_email": {
      "type": "string",
      "description": "Who viewed the profile"
    },
    "viewed_email": {
      "type": "string",
      "description": "Whose profile was viewed"
    }
  },
  "required": [
    "viewer_email",
    "viewed_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
