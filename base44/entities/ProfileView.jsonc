{
  "name": "ProfileView",
  "type": "object",
  "properties": {
    "viewer_email": {
      "type": "string",
      "description": "Who viewed the profile"
    },
    "viewed_email": {
      "type": "string",
      "description": "Whose profile was viewed"
    }
  },
  "required": [
    "viewer_email",
    "viewed_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.viewer_email": "{{user.email}}"
        },
        {
          "data.viewed_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "data.viewer_email": "{{user.email}}"
    },
    "update": {
      "data.viewer_email": "{{user.email}}"
    },
    "delete": {
      "data.viewer_email": "{{user.email}}"
    }
  }
}