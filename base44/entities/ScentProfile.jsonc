{
  "name": "ScentProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user this profile belongs to"
    },
    "display_name": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "photo_gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional photo URLs"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Man",
        "Woman",
        "Non-binary",
        "Genderfluid",
        "Agender",
        "Prefer not to say"
      ],
      "description": "User's gender identity"
    },
    "sexuality": {
      "type": "string",
      "enum": [
        "Straight",
        "Gay",
        "Lesbian",
        "Bisexual",
        "Pansexual",
        "Asexual",
        "Queer",
        "Prefer not to say"
      ],
      "description": "User's sexual orientation"
    },
    "scent_category": {
      "type": "string",
      "enum": [
        "Fresh",
        "Musky",
        "Ripe",
        "Earthy",
        "Neutral"
      ],
      "default": "Neutral"
    },
    "scent_intensity": {
      "type": "number",
      "description": "1-5 scale"
    },
    "vibe_badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fetishes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Up to 6 fetish/kink favorites"
    },
    "shower_frequency": {
      "type": "string",
      "enum": [
        "Daily",
        "Every other day",
        "Twice a week",
        "Weekly",
        "When inspired",
        "Classified"
      ]
    },
    "last_showered": {
      "type": "string",
      "format": "date"
    },
    "looking_for": {
      "type": "string",
      "enum": [
        "Casual chat",
        "Meetup",
        "Just browsing",
        "Friends",
        "Whatever happens"
      ],
      "description": "What the user is looking for"
    },
    "travel_mode": {
      "type": "string",
      "enum": [
        "neither",
        "hosting",
        "traveling",
        "traveling_from"
      ],
      "default": "neither",
      "description": "User's travel/hosting intent"
    },
    "scent_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What scent categories this user is into"
    },
    "location_lat": {
      "type": "number"
    },
    "location_lng": {
      "type": "number"
    },
    "fuzzy_location": {
      "type": "boolean",
      "default": false,
      "description": "If true, show approximate location"
    },
    "invisible_mode": {
      "type": "boolean",
      "default": false,
      "description": "If true, user does not appear on the map"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "last_active": {
      "type": "string",
      "format": "date-time"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "display_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.invisible_mode": {
            "$ne": true
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}