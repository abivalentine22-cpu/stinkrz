{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_email": {
      "type": "string"
    },
    "reported_user_email": {
      "type": "string"
    },
    "reported_user_name": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "Harassment",
        "Fake profile",
        "Inappropriate content",
        "Spam",
        "Threatening behavior",
        "Other"
      ]
    },
    "details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "reporter_email",
    "reported_user_email",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.reporter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.reporter_email": "{{user.email}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}