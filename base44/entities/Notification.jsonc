{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who receives the notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_message",
        "status_interaction"
      ],
      "description": "Type of notification"
    },
    "actor_email": {
      "type": "string",
      "description": "User who triggered the notification"
    },
    "actor_name": {
      "type": "string",
      "description": "Display name of the user who triggered it"
    },
    "actor_avatar": {
      "type": "string"
    },
    "message_id": {
      "type": "string",
      "description": "Reference to ChatMessage or StatusPost ID"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "push_attempted": {
      "type": "boolean",
      "default": false
    },
    "push_completed": {
      "type": "boolean",
      "default": false
    },
    "push_state": {
      "type": "string"
    },
    "push_claim_id": {
      "type": "string",
      "default": ""
    },
    "push_claim_until": {
      "type": "number",
      "default": 0
    },
    "push_delivered_token_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "user_email",
    "type",
    "actor_email",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
