{
  "name": "MessageReaction",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "ID of the ChatMessage"
    },
    "user_email": {
      "type": "string"
    },
    "emoji": {
      "type": "string",
      "description": "The reaction emoji"
    }
  },
  "required": [
    "message_id",
    "user_email",
    "emoji"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}